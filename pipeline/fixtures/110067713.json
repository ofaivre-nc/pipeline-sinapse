                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Le système liste l’ensemble des COMPTE.USER dont COMPTE.USER.Mail = *@cafat.nc",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1,
                "colwidth": [
                  60.0
                ]
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "2",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1,
                "colwidth": [
                  1740.0
                ]
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Règle concernant la mise à jour à faire",
                      "type": "text",
                      "marks": [
                        {
                          "type": "underline"
                        },
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Pour chaque compte utilisateur de la liste définie en règle n°1, le système récupère dans l’annuaire LDAP de la CAFAT le ",
                      "type": "text"
                    },
                    {
                      "text": "n° de tel externe",
                      "type": "text",
                      "marks": [
                        {
                          "type": "underline"
                        }
                      ]
                    },
                    {
                      "text": " et le ",
                      "type": "text"
                    },
                    {
                      "text": "n° de poste interne",
                      "type": "text",
                      "marks": [
                        {
                          "type": "underline"
                        }
                      ]
                    },
                    {
                      "text": " associé au compte dont le mail = COMPTE.USER.Mail, de façon à mettre à jour le compte utilisateur de la façon suivante:",
                      "type": "text"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
